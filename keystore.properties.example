# Where the signing key is and how to open it.
#
# Copy to `keystore.properties` beside this file and fill it in. That copy
# is ignored by git, and so is the key itself: Android installs a build over
# another only when the two signatures match, so whoever holds this key is
# the only one who can ship an upgrade to a phone that has this app on it.
#
# Without this file the build still works. The release build is simply left
# unsigned and the debug build falls back to the throwaway key Android
# generates per machine -- which is fine for a one-off, and is exactly the
# arrangement this file exists to replace: that key lives in the home
# directory of whatever machine did the build, and when the machine goes so
# does every future upgrade.

storeFile=/absolute/path/to/olo-explorer.jks
storePassword=
keyAlias=olo
keyPassword=
