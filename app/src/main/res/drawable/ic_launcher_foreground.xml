<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Two arrows: down for a download, up for an upload, which is the whole
        of what the app does.

        They are side by side rather than overlapping, and both are heavy
        enough to survive being drawn at 48px, the size that decides whether
        an icon works, because that is what a home screen shows. Every
        stroke stays inside the circle inscribed in the 72dp safe zone, so no
        launcher mask, round or square, clips an arrowhead.
    -->
    <group>
        <path
            android:pathData="M42,34 L42,70"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <path
            android:pathData="M31,59 L42,70.5 L53,59"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <!-- The upload arrow is tinted, not white: same weight, but the eye
             can tell the two directions apart at a glance. -->
        <path
            android:pathData="M66,74 L66,38"
            android:strokeColor="#9FCEF7"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <path
            android:pathData="M55,49 L66,37.5 L77,49"
            android:strokeColor="#9FCEF7"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
