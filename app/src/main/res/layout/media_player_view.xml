<?xml version="1.0" encoding="utf-8"?>
<!--
    The media player's view, inflated rather than built in code for one reason:
    the surface type. A pinch to zoom scales the whole view, and a SurfaceView's
    content does not scale with it (a TextureView's does), and the surface type
    can only be set here, in the layout, not at runtime.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="true" />
