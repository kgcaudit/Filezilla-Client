<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose draws the whole UI, so the platform theme only has to get the
        window right before the first frame. The background matches the Compose
        light surface, so the launch does not flash white.
    -->
    <style name="Theme.Olo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
