<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The file panes browse the device's own storage, which is what makes
        this a file manager rather than a download client. Two ways in,
        because the way in changed: Android 9 and below take the runtime
        permission, Android 11 and up take the all-files setting. Android 10
        takes neither and is limited to folders granted one at a time; see
        AccessRoute, which is where that decision lives.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
        A transfer has to keep running while the app is in the background, so
        it runs in a foreground service. dataSync is the type that covers
        "upload or download the user asked for"; Android 14+ refuses to start
        a foreground service whose declared type does not match what it does.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        Audio and video keep playing after the app leaves the screen, from a
        media service that shows a playback notification with its controls.
        mediaPlayback is the foreground-service type that covers it, the same
        way dataSync covers a transfer above.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Handing an .apk to the system installer.

        Since Android 8 the app that starts an install has to say so here,
        and the user has to have allowed this app to be a source. Without
        the declaration the installer is simply not reached: on Samsung's
        Android nothing happens at all, no error and no dialog, which is
        what a downloaded .apk did here.

        It does not install anything itself. It asks the platform's own
        installer to, which then shows its own confirmation.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        What this app is allowed to see of the other apps on the phone.

        Since Android 11 an app cannot list who can open a file without
        saying so here. Without it, asking the package manager which apps
        handle a video comes back empty, and a file manager that cannot
        name a single app to open a file with is not much of one. The
        declaration is the narrowest that answers the question: apps that
        can view something, and nothing else about the phone.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".FileZillaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Olo">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Opening a file means handing it to another app, and since Android 7
            a file:// URI may not cross that line. The provider grants read
            access to the one file being opened, for as long as that app is
            looking at it, and to nothing else.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            The media player's engine, so a video or a sound keeps playing
            with a notification once the app is in the background. media3's
            MediaSessionService finds this by its action; exported so the
            system's media controls and the notification can reach the
            session.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
