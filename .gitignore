# Build output
build/
out/
classes/
*.class
*.jar
# ...but not the wrapper, which is how the build is meant to be launched:
# without it `./gradlew` fails on a fresh clone with "Unable to access
# jarfile", and the commands in the README do not work at all.
!gradle/wrapper/gradle-wrapper.jar
local.properties
.gradle/

# Android
*.apk
*.aab
.cxx/

# The signing key and its password.
#
# Every build of this app is signed with one key, and Android will only
# install a build over another if the two signatures match -- so losing it
# means every phone with this app on it has to uninstall, and uninstalling
# takes the saved servers, their passwords and the transfer journal with
# it. It is kept by the person who owns the app, not in the repository:
# a key in a repository is a key that anyone with the repository can sign
# as this app with.
#
# See keystore.properties.example.
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
.vscode/

# Integration test server scratch. setup.sh rebuilds the venv from scratch
# (python3 -m venv + pip install), so committing 2105 files and 38 MB of
# platform-specific binaries bought nothing and cost every clone.
core-ftp/src/testFixtures/resources/ftps-server/venv/
core-ftp/src/testFixtures/resources/ftps-server/ftproot/
core-ftp/src/testFixtures/resources/ftps-server/*.log
core-ftp/src/testFixtures/resources/ftps-server/*.pid

# Spike scratch
spikes/**/venv/
spikes/**/ftproot/
spikes/**/*.pem
spikes/**/*.log
spikes/**/*.pid
.kotlin/
